# Gemini API 配置
GEMINI_API_KEY=your_gemini_api_key_here

# Gitee AI 配置（z-image-turbo 模型）
# 支持多个 API Key，用逗号分隔，系统会自动轮询使用
# 每个 Key 每天限量 100 张，多个 Key 可以突破限制
# 从 https://ai.gitee.com 获取你的 API Key
# 
# 单个 Key 示例：
# GITEE_AI_API_KEYS=your_api_key_1
#
# 多个 Key 示例（推荐）：
# GITEE_AI_API_KEYS=key1,key2,key3,key4,key5
GITEE_AI_API_KEYS=your_api_key_1,your_api_key_2,your_api_key_3

# 兼容旧配置（如果只有一个 Key，也可以用这个）
# GITEE_AI_API_KEY=your_single_api_key

# Maynor API 配置（可选）
MAYNOR_API_KEY=your_maynor_api_key_here
MAYNOR_API_URL=https://for.shuo.bar
